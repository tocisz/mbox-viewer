FROM scratch

# TARGETARCH will be "amd64" or "arm64" automatically set by buildx
ARG TARGETARCH

# Copy certificates (required for HTTPS/TLS, e.g. if we ever download something)
COPY --from=alpine:latest /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

WORKDIR /app

# Copy the pre-compiled binary corresponding to the architecture
COPY binary-${TARGETARCH} /app/backend
# No chmod needed in scratch (not supported/needed)

# Environment Variables
ENV PORT=8001
ENV HOST=0.0.0.0
ENV INDEX_PATH=/data/index
ENV ATTACHMENTS_DIR=/data/attachments
ENV MBOX_FILE=/data/mail.mbox

EXPOSE 8001
VOLUME ["/data"]

ENTRYPOINT ["/app/backend", "serve"]


